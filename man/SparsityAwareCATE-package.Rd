\name{SparsityAwareCATE-package}
\alias{SparsityAwareCATE}
\alias{SparsityAwareCATE-package}
\title{Sparsity- and Homogeneity-Aware Group-Specific CATE Estimation}
\description{
Methods for group-specific conditional average treatment effect estimation using
cross-fitted R-learning with simultaneous group-specific sparsity and global
cross-group homogeneity regularization.
}
\details{
The package contains the proposed ADMM estimator, nuisance-function preparation,
optional loss weighting, comparison estimators, simulation utilities, and
oracle-style structured post-selection inference.
}
\author{Xin Ye and You-Gan Wang}
